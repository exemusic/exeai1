# Copy this file to .env and replace the example values with your real secrets.
# Do not commit your .env file to source control.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI2_API_KEY="MY_GEMINI2_API_KEY"

# CEREBRAS_API_KEY: Required for Cerebras AI API calls.
CEREBRAS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE RECAPTCHA V3 SECRET KEY: Securely verified on the server-side to prevent bot spam.
# This is NOT the App Check site key and must never be exposed in frontend code.
RECAPTCHA_SECRET_KEY="6Ld8vkwtAAAAAHxXA9dwUm98sp8-1YujR_3t_KX2"

# Supabase Configuration for ExeCode & Storage
# SUPABASE_URL: The base URL of your Supabase project (default: https://knmjalxisidyduzwfwnp.supabase.co)
SUPABASE_URL="https://knmjalxisidyduzwfwnp.supabase.co"

# SUPABASE_ANON_KEY: Client/Server anon key for standard operations
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE: Server-side secret service role key (master key that bypasses RLS and handles secure deletion cleanly)
# ⚠️ CRITICAL: This key must NEVER be exposed in client-side code!
SUPABASE_SERVICE_ROLE=""

# GROQ_API_KEY: Required for Groq API calls (Llama 3.1 8B Instant).
GROQ_API_KEY=""

# Firebase Realtime Database & Admin SDK Configuration
VITE_FIREBASE_DATABASE_URL="https://exechat-data-default-rtdb.asia-southeast1.firebasedatabase.app/"

# Firebase Admin SDK Credentials (Keep in server environment)
# Option A: Full JSON string of service account key
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option B: Individual Service Account fields
FIREBASE_PROJECT_ID="exechat-data"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
