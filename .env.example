# Copy this file to .env and replace the example values with your real secrets.
# Do not commit your .env file to source control.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CEREBRAS_API_KEY: Required for Cerebras AI API calls.
CEREBRAS_API_KEY="csk-t4v6w2fwymkv2n6n24rm2j2xy9fh4pff59f5wcfjn5jkwepn"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE RECAPTCHA V3 SECRET KEY: Securely verified on the server-side to prevent bot spam.
# This is NOT the App Check site key and must never be exposed in frontend code.
RECAPTCHA_SECRET_KEY="6Ld8vkwtAAAAAHxXA9dwUm98sp8-1YujR_3t_KX2"

# FIREBASE Web app configuration. Use VITE_ prefix for Vite environment injection.
# For RTDB + Auth only, STORAGE_BUCKET / MESSAGING_SENDER_ID / MEASUREMENT_ID are optional.
VITE_FIREBASE_API_KEY="AIzaSyBOsjSCZyu9JXzpyJJO8kny_bGvsgudzL8"
VITE_FIREBASE_AUTH_DOMAIN="exeai-by-hexky.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://exeai-by-hexky-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="exeai-by-hexky"
VITE_FIREBASE_STORAGE_BUCKET="exeai-by-hexky.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="585171848007"
VITE_FIREBASE_APP_ID="1:585171848007:web:f481cb1936f00d6e2f1a62"
VITE_FIREBASE_MEASUREMENT_ID="G-TBP1D6M8E7"

# Optional App Check config for Realtime Database protection.
# Set these only if you enable App Check in Firebase Console and register a reCAPTCHA provider.
VITE_FIREBASE_APP_CHECK_PROVIDER="enterprise" # or "v3"
VITE_FIREBASE_RECAPTCHA_SITE_KEY="YOUR_RECAPTCHA_SITE_KEY"

# Supabase Configuration for Audio File Storage
# SUPABASE_URL: The base URL of your Supabase project
SUPABASE_URL="https://cckqvxbepllqvbhyqrub.supabase.co"

# SUPABASE_SECRET_KEY: Server-side secret key for secure file uploads
# ⚠️ CRITICAL: This key must NEVER be exposed in client-side code!
# It's used only on the server-side backend for authenticated file uploads to protect against abuse.
# Keep this secret safe and never commit it to version control.
SUPABASE_SECRET_KEY="sb_secret_AD_rlTa-NeitF1v-jbxJ8A_XQj3sAFu"

